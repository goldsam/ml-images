{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build devcontainer image",
            "type": "shell",
            "command": "make",
            "args": ["build", "devcontainer"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Build all images",
            "type": "shell",
            "command": "make",
            "args": ["build", "all"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Smoke test devcontainer",
            "type": "shell",
            "command": "make",
            "args": ["test"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": [],
            "dependsOn": ["Build devcontainer image"]
        }
    ]
}
